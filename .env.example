# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# PostgreSQL Online Database Connection String
# Examples:
# Supabase:   postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:5432/postgres
# Neon:       postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Render:     postgresql://user:password@dpg-xxxx-a.oregon-postgres.render.com/dbname
# Railway:    postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
# Aiven:      postgresql://avnadmin:password@pg-service.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=postgresql://username:password@host:5432/database

# Optional Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional File Storage Configuration
# UPLOAD_FOLDER=/path/to/persistent/uploads
# PDF_FOLDER=/path/to/persistent/pdf
